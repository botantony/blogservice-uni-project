cabal-version:      2.4
name:               blogservice
version:            0.1.0.0
synopsis:           Simple blog website made for OS course
license:            MIT
license-file:       LICENSE
author:             Anton Melnikov
maintainer:         antonsm21@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

executable blogservice
    main-is:          Main.hs
    other-modules:    Types
                      , Database
                      , Routes
                      , Session
                      , Views

    build-depends:    base >=4.16.0.0
                      , scotty
                      , wai
                      , wai-extra
                      , http-types
                      , text
                      , bytestring
                      , aeson
                      , postgresql-simple
                      , resource-pool
                      , time
                      , transformers
                      , bcrypt
                      , clientsession
                      , wai-session
                      , vault
                      , cookie
                      , blaze-html
                      , blaze-markup
                      , envy
                      , base64-bytestring
                      , directory
                      , filepath

    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
